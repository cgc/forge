<config>
  <executableName>${app.executable}</executableName>
  <mainClass>${app.mainclass}</mainClass>
  <os>ios</os>
  <arch>arm64</arch>
  <resources>
    <resource>
      <directory>../forge-gui</directory>
      <includes>
        <include>res/**</include>
      </includes>
    </resource>
    <resource>
      <directory>../forge-gui-android/assets</directory>
      <includes>
        <include>fallback_skin/**</include>
      </includes>
    </resource>
    <resource>
      <directory>res</directory>
    </resource>
  </resources>
  <target>ios</target>
  <iosInfoPList>Info.plist.xml</iosInfoPList>
  <forceLinkClasses>
    <pattern>java.util.logging.**</pattern>
    <pattern>com.esotericsoftware.minlog.Log</pattern>
    <!--
      Use targeted patterns instead of com.badlogic.gdx.** (the previous wildcard).

      The wildcard caused UIAccelerometer's static initializer to run eagerly at
      process startup:  static { ObjCRuntime.bind(UIAccelerometer.class) }  which
      calls [UIAccelerometer class], firing its +initialize, which creates an
      internal CMMotionManager that tries to read the MDM-controlled CoreMotion
      plist and logs a noisy permission warning on supervised devices.

      With targeted patterns the UIAccelerometer class is still compiled into the
      binary (it is referenced transitively by DefaultIOSInput), but its static
      initializer runs only when the class is first *used*.  Because
      config.useAccelerometer = false the setupAccelerometer() code is never
      entered, UIAccelerometer is never touched, and CoreMotion stays dormant.

      Pattern rationale (matches Shattered Pixel Dungeon's robovm.xml approach):
        scenes.scene2d.ui.*  – Skin loads widget classes by name from JSON; these
                               classes must be force-linked or the linker strips them.
      All libGDX iOS backend classes (IOSApplication, IOSGraphics, DefaultIOSInput,
      etc.) are reachable via the compile-time reference chain from Main and are
      compiled and registered automatically without force-linking.
    -->
    <pattern>com.badlogic.gdx.scenes.scene2d.ui.*</pattern>
    <pattern>com.badlogic.gdx.physics.box2d.*</pattern>
    <pattern>com.android.okhttp.HttpsHandler</pattern>
    <!--
      The Android/MobiVM SSL security providers are referenced exclusively via
      Class.forName() inside the Java security subsystem (Security.insertProviderAt).
      Without force-linking, the static linker strips them from the binary,
      Class.forName() fails at runtime, and the TLS/HTTPS stack cannot initialize —
      preventing all online card-image downloads.  Adding broad wildcard patterns
      is the canonical fix recommended in the warning message itself.
    -->
    <pattern>com.android.org.conscrypt.**</pattern>
    <pattern>com.android.org.bouncycastle.**</pattern>
    <pattern>org.apache.harmony.security.**</pattern>
    <pattern>org.apache.xalan.processor.TransformerFactoryImpl</pattern>
    <pattern>com.badlogic.gdx.controllers.IosControllerManager</pattern>
    <pattern>forge.util.StreamUtil</pattern>
    <pattern>com.ray3k.tenpatch.TenPatchDrawable</pattern>
  </forceLinkClasses>
  <frameworks>
    <framework>UIKit</framework>
    <framework>OpenGLES</framework>
    <framework>QuartzCore</framework>
    <framework>CoreGraphics</framework>
    <framework>OpenAL</framework>
    <framework>AudioToolbox</framework>
    <framework>AVFoundation</framework>
  </frameworks>
</config>
