<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
        <packaging.type>jar</packaging.type>
        <build.min.memory>-Xms128m</build.min.memory>
        <build.max.memory>-Xmx2048m</build.max.memory>
        <robovm.version>2.3.23</robovm.version>
        <!-- Auto-detected via the apple-silicon profile below; override with -Dios.simulator.arch=... -->
        <ios.simulator.arch>x86_64</ios.simulator.arch>
    </properties>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-ios</artifactId>
    <packaging>${packaging.type}</packaging>
    <name>Forge iOS</name>

    <!--
      Local file-system repository containing a patched robovm-dist-compiler jar.
      robovm-dist-compiler is the shaded fat-jar used by robovm-maven-plugin; it
      embeds robovm-soot classes directly. The patch fixes four bugs in the bundled
      soot that cause AOT compilation to crash on Java Record classes (invokedynamic
      with REF_getField bootstrap handles). Run scripts/patch-robovm-soot.sh once
      after cloning to populate this directory; it is gitignored so the binary jar
      is never committed.

      The patched jar is stored as version 2.3.23-patched (not 2.3.23) because Maven
      permanently caches release artifacts in ~/.m2. If robovm-dist-compiler:2.3.23
      was previously downloaded from Maven Central it will be used from the local
      cache regardless of this file:// repo. The -patched version does not exist on
      Central so Maven always resolves it from forge-local.
    -->
    <repositories>
        <repository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!--
              Stream-desugaring: rewrite Collection.stream(), Iterable.spliterator(),
              Arrays.stream(), File.toPath(), and BufferedReader.lines() call sites in the
              compiled class files so that RoboVM's AOT compiler never encounters these
              Java-8 methods that are absent from MobiVM's robovm-rt.

              This runs during process-classes (after compilation, before the RoboVM package
              phase) and transforms BOTH the sibling modules' target/classes/ directories AND
              their packaged JARs in target/.

              Both must be transformed because in a Maven reactor build the sibling modules
              complete their entire lifecycle (including package) before forge-gui-ios starts.
              RoboVM's Maven plugin resolves inter-module dependencies to the JAR artifacts in
              target/ (not to the raw target/classes directories), so the JARs must be
              patched in-place here, before RoboVM's package goal runs.

              See scripts/StreamDesugar.java and scripts/desugar-streams.sh for details.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>desugar-streams</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/desugar-streams.sh</argument>
                                <!-- classes directories (for forge-gui-ios itself and sibling modules) -->
                                <argument>${project.basedir}/../forge-core/target/classes</argument>
                                <argument>${project.basedir}/../forge-ai/target/classes</argument>
                                <argument>${project.basedir}/../forge-gui/target/classes</argument>
                                <argument>${project.basedir}/../forge-game/target/classes</argument>
                                <argument>${project.basedir}/../forge-gui-mobile/target/classes</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <!-- JAR files: in a Maven reactor build every sibling module is
                                     packaged (phase=package) before forge-gui-ios starts, so the
                                     JARs in target/ exist at this point but contain untransformed
                                     bytecode.  RoboVM's Maven plugin resolves inter-module
                                     dependencies to these JARs (not to target/classes), so we must
                                     transform them in-place here, before the package phase begins. -->
                                <argument>${project.basedir}/../forge-core/target/forge-core-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-ai/target/forge-ai-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-gui/target/forge-gui-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-game/target/forge-game-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-gui-mobile/target/forge-gui-mobile-${project.version}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>filters</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <finalName>forge-ios-${revision}</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-mobile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-robovm</artifactId>
            <version>1.13.5</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <!-- Java 8 API stubs: MobiVM's robovm-rt lacks java.util.function.*,
             java.util.stream.*, java.util.Optional, java.util.Spliterator,
             and java.nio.file.*. These stubs provide working implementations
             (stream operations backed by ArrayList) so that RoboVM's AOT
             compiler includes the types and runtime calls succeed on iOS.
             Built by: bash scripts/build-java-stubs.sh

             Version 1.2 (previously 1.1): added Collector.Characteristics inner enum
             and characteristics() method to the Collector stub.  Without this enum,
             Guava's CollectCollectors class fails to initialize with
             NoClassDefFoundError: [Ljava/util/stream/Collector$Characteristics;

             Version 1.1 (previously 1.0): the stubs now strip lambda bodies
             from java.util.function.* default methods (andThen/compose/negate/
             and/or).  Without stripping, RoboVM's AOT compiler generates
             $$Lambda$N synthetic classes for each invokedynamic inside those
             default methods and emits [lookup] references to the synthetic
             lambda$*$N methods; those symbols are never linked because the
             interface is not in librobovm-rt.a → "Undefined symbols" linker
             error.

             Using version 1.2 (not 1.1 or 1.0) is essential: Maven caches release
             artifacts permanently in ~/.m2 and will use a previously built stubs
             jar for every subsequent build, regardless of what is in forge-local.
             Version 1.2 has never been cached so Maven always resolves it
             fresh from forge-local. -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>java-stubs</artifactId>
            <version>1.2</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>ios-device</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Load the patched robovm-dist-compiler first on the plugin classpath.
                             The -patched version is never cached from Central so Maven always
                             resolves it from forge-local, regardless of ~/.m2 state. -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-device-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>create-ipa</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>arm64</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ios-simulator</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Load the patched robovm-dist-compiler first on the plugin classpath.
                             See ios-device profile comment above for rationale. -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-simulator-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>iphone-sim</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>${ios.simulator.arch}</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Automatically use arm64 simulator slice on Apple Silicon Macs. -->
            <id>apple-silicon</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <ios.simulator.arch>arm64</ios.simulator.arch>
            </properties>
        </profile>
    </profiles>
</project>
