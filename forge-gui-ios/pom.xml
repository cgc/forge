<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
        <packaging.type>jar</packaging.type>
        <build.min.memory>-Xms128m</build.min.memory>
        <build.max.memory>-Xmx2048m</build.max.memory>
        <robovm.version>2.3.23</robovm.version>
        <!-- Auto-detected via the apple-silicon profile below; override with -Dios.simulator.arch=... -->
        <ios.simulator.arch>x86_64</ios.simulator.arch>
    </properties>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-ios</artifactId>
    <packaging>${packaging.type}</packaging>
    <name>Forge iOS</name>

    <!--
      Local file-system repository containing a patched robovm-dist-compiler jar.
      robovm-dist-compiler is the shaded fat-jar used by robovm-maven-plugin; it
      embeds robovm-soot classes directly. The patch fixes four bugs in the bundled
      soot that cause AOT compilation to crash on Java Record classes (invokedynamic
      with REF_getField bootstrap handles). Run scripts/patch-robovm-soot.sh once
      after cloning to populate this directory; it is gitignored so the binary jar
      is never committed.

      The patched jar is stored as version 2.3.23-patched (not 2.3.23) because Maven
      permanently caches release artifacts in ~/.m2. If robovm-dist-compiler:2.3.23
      was previously downloaded from Maven Central it will be used from the local
      cache regardless of this file:// repo. The -patched version does not exist on
      Central so Maven always resolves it from forge-local.
    -->
    <repositories>
        <repository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>filters</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <finalName>forge-ios-${revision}</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-mobile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-robovm</artifactId>
            <version>1.13.5</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <!-- java.nio.file stubs: MobiVM runtime lacks java.nio.file.*; these stubs
             (backed by java.io.File) shadow the missing package so both javac and
             RoboVM's AOT pass can resolve all java.nio.file references.
             Built by: bash scripts/build-nio-file-stubs.sh -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>nio-file-stubs</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>ios-device</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Load the patched robovm-dist-compiler first on the plugin classpath.
                             The -patched version is never cached from Central so Maven always
                             resolves it from forge-local, regardless of ~/.m2 state. -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-device-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>create-ipa</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>arm64</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ios-simulator</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Load the patched robovm-dist-compiler first on the plugin classpath.
                             See ios-device profile comment above for rationale. -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-simulator-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>iphone-sim</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>${ios.simulator.arch}</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Automatically use arm64 simulator slice on Apple Silicon Macs. -->
            <id>apple-silicon</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <ios.simulator.arch>arm64</ios.simulator.arch>
            </properties>
        </profile>
    </profiles>
</project>
