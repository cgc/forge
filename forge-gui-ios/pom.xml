<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
        <packaging.type>jar</packaging.type>
        <build.min.memory>-Xms128m</build.min.memory>
        <build.max.memory>-Xmx2048m</build.max.memory>
        <robovm.version>2.3.24</robovm.version>
        <!-- Use arm64 on Apple Silicon Macs: -Dios.simulator.arch=arm64 -->
        <ios.simulator.arch>x86_64</ios.simulator.arch>
    </properties>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <!--
      Local file-system repository containing a patched robovm-soot jar.
      The patch fixes CONSTANT_Fieldref_info.createJimpleConstantValue() which was
      missing the slash-to-dot class-name conversion already present in Methodref and
      InterfaceMethodref. Without the fix, compiling any class whose methods use
      invokedynamic with REF_getField bootstrap handles (i.e. every Java record's
      generated equals/hashCode/toString) throws an error about RefType containing a slash.
    -->
    <repositories>
        <repository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
        </pluginRepository>
    </pluginRepositories>

    <artifactId>forge-gui-ios</artifactId>
    <packaging>${packaging.type}</packaging>
    <name>Forge iOS</name>


    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>filters</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <finalName>forge-ios-${revision}</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-mobile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-robovm</artifactId>
            <version>1.14.0</version>
        </dependency>
        <!-- Override the robovm-rt/objc/cocoatouch versions pulled in transitively by
             gdx-backend-robovm (which defaults to 2.3.23) to match our robovm.version. -->
        <dependency>
            <groupId>com.mobidevelop.robovm</groupId>
            <artifactId>robovm-rt</artifactId>
            <version>${robovm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mobidevelop.robovm</groupId>
            <artifactId>robovm-objc</artifactId>
            <version>${robovm.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mobidevelop.robovm</groupId>
            <artifactId>robovm-cocoatouch</artifactId>
            <version>${robovm.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>ios-device</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <dependencies>
                            <!-- Patched robovm-soot: fixes CONSTANT_Fieldref_info missing
                                 slash-to-dot conversion in createJimpleConstantValue(), which
                                 caused "Attempt to create RefType containing a /" for every Java
                                 record (records use invokedynamic with REF_getField handles). -->
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-soot</artifactId>
                                <version>2.5.0-9-forge-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-device-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>create-ipa</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>arm64</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ios-simulator</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-soot</artifactId>
                                <version>2.5.0-9-forge-patched</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-simulator-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>iphone-sim</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>${ios.simulator.arch}</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
