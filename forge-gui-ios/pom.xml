<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <properties>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>
        <packaging.type>jar</packaging.type>
        <build.min.memory>-Xms128m</build.min.memory>
        <build.max.memory>-Xmx2048m</build.max.memory>
        <robovm.version>2.3.23</robovm.version>
        <!-- Auto-detected via the apple-silicon profile below; override with -Dios.simulator.arch=... -->
        <ios.simulator.arch>x86_64</ios.simulator.arch>
    </properties>

    <parent>
        <artifactId>forge</artifactId>
        <groupId>forge</groupId>
        <version>${revision}</version>
    </parent>

    <artifactId>forge-gui-ios</artifactId>
    <packaging>${packaging.type}</packaging>
    <name>Forge iOS</name>

    <!--
      Local file-system repository containing locally-built artifacts (java-stubs,
      ASM cache, and the robovmx dist-compiler extracted by install-robovmx.sh).
      See scripts/install-robovmx.sh for details.
    -->
    <repositories>
        <repository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>forge-local</id>
            <url>file://${project.basedir}/local-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <!--
              Build-time bytecode transformer for the iOS (robovmx) build.
              robovmx's runtime is based on Android 12's libcore (libcore12) and
              natively provides all Java 8+ APIs.  The only call sites that require
              rewriting are:
                • String.isBlank() / String.repeat()  — Java 11 methods absent from
                  robovmx's String implementation
                • BreakIterator.getLineInstance(Locale) — ICU data absent on iOS
              See scripts/StreamDesugar.java and scripts/desugar-streams.sh for details.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>desugar-streams</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.basedir}/../scripts/desugar-streams.sh</argument>
                                <!-- classes directories (for forge-gui-ios itself and sibling modules) -->
                                <argument>${project.basedir}/../forge-core/target/classes</argument>
                                <argument>${project.basedir}/../forge-ai/target/classes</argument>
                                <argument>${project.basedir}/../forge-gui/target/classes</argument>
                                <argument>${project.basedir}/../forge-game/target/classes</argument>
                                <argument>${project.basedir}/../forge-gui-mobile/target/classes</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <!-- JAR files: in a Maven reactor build every sibling module is
                                     packaged (phase=package) before forge-gui-ios starts, so the
                                     JARs in target/ exist at this point but contain untransformed
                                     bytecode.  RoboVM's Maven plugin resolves inter-module
                                     dependencies to these JARs (not to target/classes), so we must
                                     transform them in-place here, before the package phase begins. -->
                                <argument>${project.basedir}/../forge-core/target/forge-core-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-ai/target/forge-ai-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-gui/target/forge-gui-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-game/target/forge-game-${project.version}.jar</argument>
                                <argument>${project.basedir}/../forge-gui-mobile/target/forge-gui-mobile-${project.version}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>filters</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <finalName>forge-ios-${revision}</finalName>
    </build>

    <dependencies>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>forge</groupId>
            <artifactId>forge-gui-mobile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-robovm</artifactId>
            <version>1.13.5</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>1.13.5</version>
            <classifier>natives-ios</classifier>
        </dependency>
        <!-- Java API stubs: robovmx's libcore12 runtime (Android 12) natively provides
             all Java 8+ APIs.  The one class still absent is java.lang.Record, which
             was introduced in Java 16 — after Android 12's class library was frozen.
             Every Java record implicitly extends Record; without this stub RoboVM's AOT
             compiler fails with NoClassDefFoundError.
             Built by: bash scripts/build-java-stubs.sh

             WHY ANDROID DOESN'T NEED THIS: the Android build uses D8/R8 with
             min-sdk-version=26 which already has Record support via desugaring.

             Using version 3.0: Maven caches release artifacts permanently in ~/.m2;
             the version number must be bumped whenever the stub content changes.
             The robovmx compiler itself is installed by bash scripts/install-robovmx.sh
             and wired in via the plugin dependency override in the ios-device/ios-simulator
             profiles below. -->
        <dependency>
            <groupId>forge</groupId>
            <artifactId>java-stubs</artifactId>
            <version>3.0</version>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>ios-device</id>
            <build>
                <plugins>
                    <!-- Ensure forge-gui-ios/robovm-home/ is populated with the merged
                         RoboVM dist before the robovm-maven-plugin runs.  The <home>
                         configuration below directs the plugin to use robovm-home/ as its
                         unpack base; AbstractRoboVMMojo.unpackRoboVMDist() skips extraction
                         when that directory already exists.  See install-robovmx.sh Step 4. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ensure-robovm-bro-bridge-device</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/ensure-robovm-bro-bridge.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Override the bundled robovm-dist-compiler with the robovmx build.
                             robovmx replaces MobiVM's Android 4.4-era runtime with Android 12's
                             libcore12, providing native Java 8+ support.  The -robovmx version
                             is never published to Maven Central so Maven always resolves it from
                            forge-local (populated by scripts/install-robovmx.sh). -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-robovmx</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-device-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>create-ipa</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Point to the project-local robovmx home directory populated by
                                 scripts/install-robovmx.sh.  This causes unpackRoboVMDist() to
                                 use robovm-home/ as the unpack base and skip extraction since
                                 the directory already exists (non-SNAPSHOT version). -->
                            <home>${project.basedir}/robovm-home</home>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>arm64</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ios-simulator</id>
            <build>
                <plugins>
                    <!-- Ensure forge-gui-ios/robovm-home/ is populated with the merged
                         RoboVM dist.  See ios-device profile comment above for rationale. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ensure-robovm-bro-bridge-simulator</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../scripts/ensure-robovm-bro-bridge.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.mobidevelop.robovm</groupId>
                        <artifactId>robovm-maven-plugin</artifactId>
                        <version>${robovm.version}</version>
                        <!-- Override the bundled robovm-dist-compiler with the robovmx build.
                            See ios-device profile comment above for rationale. -->
                        <dependencies>
                            <dependency>
                                <groupId>com.mobidevelop.robovm</groupId>
                                <artifactId>robovm-dist-compiler</artifactId>
                                <version>2.3.23-robovmx</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>ios-simulator-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>iphone-sim</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Same home directory as the ios-device profile.
                                 See ios-device profile comment for rationale. -->
                            <home>${project.basedir}/robovm-home</home>
                            <propertiesFile>robovm.properties</propertiesFile>
                            <configFile>robovm.xml</configFile>
                            <arch>${ios.simulator.arch}</arch>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Automatically use arm64 simulator slice on Apple Silicon Macs. -->
            <id>apple-silicon</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <ios.simulator.arch>arm64</ios.simulator.arch>
            </properties>
        </profile>
    </profiles>
</project>
